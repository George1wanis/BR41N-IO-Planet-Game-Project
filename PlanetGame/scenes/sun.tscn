[gd_scene load_steps=6 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends StaticBody3D

@onready var light = $OmniLight3D
@onready var mesh = $MeshInstance3D

var time = 0.0

func _process(delta):
	time += delta
	# Make the sun pulse slightly
	var pulse = 1.0 + (sin(time * 2.0) * 0.05)
	mesh.scale = Vector3(pulse, pulse, pulse)
	light.light_energy = 5.0 + (sin(time * 2.0) * 1.0)
"

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
shading_mode = 0
albedo_color = Color(1, 0.95, 0.6, 1)

[sub_resource type="SphereMesh" id="SphereMesh_1"]
material = SubResource("StandardMaterial3D_1")
radius = 5.0
height = 10.0

[sub_resource type="SphereShape3D" id="SphereShape3D_1"]
radius = 5.0

[node name="Sun" type="StaticBody3D"]
script = SubResource("GDScript_1")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_1")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("SphereShape3D_1")

[node name="OmniLight3D" type="OmniLight3D" parent="."]
light_color = Color(1, 0.9, 0.7, 1)
light_energy = 5.0
omni_range = 300.0
omni_attenuation = 0.4
shadow_enabled = true
