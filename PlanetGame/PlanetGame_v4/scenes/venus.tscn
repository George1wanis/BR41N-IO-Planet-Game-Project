[sub_resource type="GDScript" id="1"]
script/source = "extends StaticBody3D
const FLICKER_HZ: float = 10.0
var _time_acc: float = 0.0
var _half_period: float = 1.0 / (FLICKER_HZ * 2.0)
var _flicker_on: bool = true

func _process(delta):
	rotate_y(delta * -0.0004) # Very slow retrograde rotation for Venus (243 Earth days)
# 10 Hz SSVEP flicker: toggle mesh visibility for maximum contrast
	_time_acc += delta
	if _time_acc >= _half_period:
		_time_acc -= _half_period
		_flicker_on = !_flicker_on
		$MeshInstance3D.visible = _flicker_on
"

