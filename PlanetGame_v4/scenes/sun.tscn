[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends StaticBody3D

@onready var light = $OmniLight3D
var time = 0.0

func _process(delta):
	time += delta
	# Sun glow pulse - no rotation
	light.light_energy = 6.0 + (sin(time * 1.5) * 1.5)
"

